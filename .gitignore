# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# IDE
.cursor/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local deployment scratch (server recon notes, session-only scripts)
/.deploy-ref/

# nested clone of https://github.com/Leonxlnx/taste-skill (skills copied into .agents/skills)
/.taste-skill-src/

# local agent skills checkout and session scratch
/.agents/
/.scratch/pagination-probe/
/.scratch/*.png
/.scratch/*.sql
/.scratch/*.mjs
/mydash-src.tar.gz

# local-only JWT mint helper (signs with a real secret; never ship it)
/scripts/mint-dev-token.mjs
